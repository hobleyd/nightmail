<?xml version="1.0" encoding="utf-8"?>
<!-- Paths the FileProvider may hand out to other apps.

     Only the app's own cache directory is listed, because that is the one place
     the in-app updater writes: AndroidApkUpdater downloads the APK into
     getTemporaryDirectory() and the system package installer reads it back
     through this provider. Nothing here grants access to external storage, so
     no storage permission is needed. -->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <cache-path name="cache" path="." />
</paths>
